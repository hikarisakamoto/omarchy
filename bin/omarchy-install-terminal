#!/bin/bash

# Install one of the approved terminals and set it as the default for Omarchy (Super + Return etc).

if (($# == 0)); then
  echo "Usage: omarchy-install-terminal [alacritty|ghostty|kitty|wezterm]"
  exit 1
fi

package="$1"
desktop_override=""

# Map package name to desktop entry ID
case "$package" in
alacritty) desktop_id="Alacritty.desktop" ;;
ghostty) desktop_id="com.mitchellh.ghostty.desktop" ;;
kitty) desktop_id="kitty.desktop" ;;
wezterm)
  desktop_id="org.wezfurlong.wezterm.desktop"
  desktop_override="WezTerm.desktop"
  ;;
*)
  echo "Unknown terminal: $package"
  exit 1
  ;;
esac

if [[ $package == "alacritty" ]]; then
  desktop_override="Alacritty.desktop"
fi

# Install package
if omarchy-pkg-add $package; then
  # Copy custom desktop entry when the terminal needs X-TerminalArg* keys
  if [[ -n $desktop_override ]]; then
    mkdir -p ~/.local/share/applications
    cp "$OMARCHY_PATH/applications/$desktop_override" ~/.local/share/applications/$desktop_id
  fi

  # Update xdg-terminals.list to prioritize the proper terminal
  cat >~/.config/xdg-terminals.list <<EOF
# Terminal emulator preference order for xdg-terminal-exec
# The first found and valid terminal will be used
$desktop_id
EOF
else
  echo "Failed to install $package"
fi
